#include<stdio.h>
int main()
{
    int n,i,j,k;
    scanf("%d",&n);
    for(i=n;i>=1;i--)
    {
        for(j=1;j<=i;j++)
        {
            printf("%d",i);
        }
        for(k=1;k<=n-i;k++)
        {
            printf("*");
        }
        printf("\n");
    }
    return 0;
}
